# ---- site ----
SITE_NAME=Arcana Press
SITE_TAGLINE=A tarot reading that answers the question you actually asked.
PUBLIC_SITE_URL=https://your-domain.example
APP_PORT=5000

# ---- interpretation ----
# The site is fully functional without a key: readings are composed from the
# card corpus instead. A key upgrades the interpretation, it does not enable it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
QUESTION_MAX_CHARS=160

# ---- crawl staging ----
# Which combination pages enter the sitemap. All 6,084 routes always resolve;
# this only controls what is submitted for indexing.
#   none    — no combination pages (launch setting)
#   majors  — 484 major-on-major pages (default; stage two)
#   all     — all 6,084 (only once single-card indexation is proven >70%)
COMBO_SITEMAP_SCOPE=majors
