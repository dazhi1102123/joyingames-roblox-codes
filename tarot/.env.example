# ---- site ----
SITE_NAME=Arcana Press
SITE_TAGLINE=A tarot reading that answers the question you actually asked.
PUBLIC_SITE_URL=https://your-domain.example
APP_PORT=5000

# ---- interpretation ----
# The site is fully functional without a key: readings are composed from the
# card corpus instead. A key upgrades the interpretation, it does not enable it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
QUESTION_MAX_CHARS=160

# ---- crawl staging ----
# Which combination pages enter the sitemap. All 6,084 routes always resolve;
# this only controls what is submitted for indexing.
#   none    — no combination pages (launch setting)
#   majors  — 484 major-on-major pages (default; stage two)
#   all     — all 6,084 (only once single-card indexation is proven >70%)
COMBO_SITEMAP_SCOPE=majors

# ---- sessions ----
# MUST be set in production. Without it a restart invalidates every reader
# session, signing people out mid-queue.
SECRET_KEY=

# ---- human readings ----
HUMAN_READINGS=1
# Where the SQLite file lives. In Docker this path is on a named volume —
# losing it loses every in-flight order.
READINGS_DB=/data/readings.db
# Orders (including what the querent wrote) are deleted this many days after
# the request. Deletion runs on the request path, not a cron job.
ORDER_RETENTION_DAYS=90

# ---- payment ----
# manual = settlement happens out of band and an operator confirms it at /admin.
# waffo  = Waffo as Merchant of Record. THE WAFFO ADAPTER IS UNVERIFIED — its
#          docs were unreachable when it was written. Run `python payments.py
#          check` with real keys and fix payments.py before switching to it.
PAYMENT_PROVIDER=manual

# Unlocks /admin, where unpaid orders are released into the reader queue.
# Unset means no admin surface exists at all.
ADMIN_KEY=

WAFFO_API_KEY=
WAFFO_STORE_SLUG=
WAFFO_PRODUCT_ID=
WAFFO_ENVIRONMENT=sandbox
WAFFO_WEBHOOK_SECRET=
# Waffo permit this category only with WeChat Pay excluded. Comma separated.
# Do not empty this without a written change from them.
WAFFO_EXCLUDED_METHODS=wechat_pay

# ---- who operates this site ----
# The Impressum, the privacy policy and every email footer are built from these.
# Anything left blank is rendered as a visible MISSING marker on the legal pages.
OPERATOR_NAME=OneFusion
OPERATOR_LEGAL_NAME=
OPERATOR_ADDRESS=
OPERATOR_COUNTRY=
OPERATOR_REG_NUMBER=
OPERATOR_VAT=
OPERATOR_EMAIL=

# ---- email ----
# Two channels that must NOT share a domain. Transactional carries confirmation
# links and delivered readings; marketing carries the daily card. A campaign
# must never be able to damage the reputation the product depends on — the code
# refuses to send marketing if these domains match.
#   providers: console (prints, default) | smtp | resend
MAIL_TX_PROVIDER=console
MAIL_TX_FROM=Arcana Press <hello@your-domain.example>
MAIL_TX_REPLY_TO=
MAIL_TX_API_KEY=
MAIL_TX_SMTP_HOST=
MAIL_TX_SMTP_PORT=587
MAIL_TX_SMTP_USER=
MAIL_TX_SMTP_PASSWORD=

MAIL_MK_PROVIDER=console
MAIL_MK_FROM=Arcana Press <daily@your-sending-domain.example>
MAIL_MK_REPLY_TO=
MAIL_MK_API_KEY=
MAIL_MK_SMTP_HOST=
MAIL_MK_SMTP_PORT=587
MAIL_MK_SMTP_USER=
MAIL_MK_SMTP_PASSWORD=

# Set to send yourself one of each with `python mailer.py`
MAIL_CHECK_TO=
